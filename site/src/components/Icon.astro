---
// The kit's built-in icon set (no icon font, no network). `logo_icon` in docs-kit.yml takes one of these names;
// Material Design Icons names used by MkDocs projects map to the nearest one, anything else falls back to "book".
interface Props {
	name: string;
	size?: number;
	label?: string;
}
const ICONS: Record<string, string> = {
	book: 'M4 5.5C6.5 4 9.5 4 12 5.5v14C9.5 18 6.5 18 4 19.5zM12 5.5C14.5 4 17.5 4 20 5.5v14c-2.5-1.5-5.5-1.5-8 0',
	'book-pages': 'M4 5.5C6.5 4 9.5 4 12 5.5v14C9.5 18 6.5 18 4 19.5zM12 5.5C14.5 4 17.5 4 20 5.5v14c-2.5-1.5-5.5-1.5-8 0M6.5 8.5h3M6.5 11.5h3M14.5 8.5h3M14.5 11.5h3',
	file: 'M7 3h7l5 5v13H7zM14 3v5h5',
	robot: 'M8 8h8a3 3 0 0 1 3 3v6a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3v-6a3 3 0 0 1 3-3zM12 4v4M9.5 13h0M14.5 13h0M9 17h6M3 13v3M21 13v3',
	flask: 'M9 3h6M10 3v6l-5 9a2 2 0 0 0 1.8 3h10.4A2 2 0 0 0 19 18l-5-9V3M7.5 14h9',
	cube: 'M12 3l8 4.5v9L12 21l-8-4.5v-9zM12 12l8-4.5M12 12v9M12 12L4 7.5',
	sitemap: 'M9 3h6v5H9zM3 16h6v5H3zM15 16h6v5h-6zM12 8v4M6 16v-2h12v2',
	search: 'M10.5 4a6.5 6.5 0 1 1 0 13 6.5 6.5 0 0 1 0-13zM15.5 15.5L20 20',
	moon: 'M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z',
	sun: 'M12 8a4 4 0 1 1 0 8 4 4 0 0 1 0-8zM12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4',
	menu: 'M4 6h16M4 12h16M4 18h16',
	close: 'M6 6l12 12M18 6L6 18',
	'chevron-left': 'M15 5l-7 7 7 7',
	'chevron-right': 'M9 5l7 7-7 7',
	'chevron-down': 'M5 9l7 7 7-7',
	'arrow-up': 'M12 20V5M5 12l7-7 7 7',
	copy: 'M9 9h10v12H9zM5 15V3h10',
	check: 'M5 12.5l4.5 4.5L19 7',
	link: 'M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1',
};
const MDI: Record<string, string> = {
	'book-open-page-variant': 'book-pages', 'book-open-variant': 'book', 'book-open': 'book', 'book-outline': 'book', book: 'book',
	'file-document': 'file', 'file-document-outline': 'file', robot: 'robot', 'robot-industrial': 'robot', flask: 'flask', 'flask-outline': 'flask',
	cube: 'cube', 'cube-outline': 'cube', sitemap: 'sitemap',
};
const { name, size = 20, label } = Astro.props;
const key = ICONS[name] ? name : MDI[name.replace(/^material\//, '')] ?? 'book';
---
<svg
	class="kit-icon"
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.8"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden={label ? undefined : 'true'}
	role={label ? 'img' : undefined}
	aria-label={label}
><path d={ICONS[key]} /></svg>
